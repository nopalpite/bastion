# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# noVNC vendoré au build (voir README) — pas commité, cloné/copié à part
static/novnc/

# Contenu généré / mutable en run
vnc_tokens.conf
static/uploads/maps/*
!static/uploads/maps/.gitkeep

# Secrets locaux
.env

# Dossiers de bind-mount Docker locaux (docker-compose.yml), créés/remplis
# au 1er démarrage — voir la section "Lancement avec Docker" du README.
/config/
/data/

# Certificat TLS auto-signé généré localement (voir tls.py,
# BASTION_TLS_SELFSIGNED) — contient une clé privée, jamais commité. En
# Docker il finit dans /config/tls (déjà ignoré ci-dessus) ; en dev local
# sans BASTION_DATA_DIR, il atterrit ici, à la racine du dépôt.
/tls/

# Éditeurs / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
